# Public values embedded in the app. Never add service-account or payment secrets.
# Include /api for the existing Nginx proxy; direct API uses /v1.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_AUTH_ENABLED=false
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_APPLE_SERVICE_ID=
EXPO_PUBLIC_APPLE_REDIRECT_URI=
# Native build configuration only; not EXPO_PUBLIC.
WH_FIREBASE_NATIVE=false
GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist
GOOGLE_IOS_URL_SCHEME=
# Optional after `eas init`; leave unset until a real Expo project exists.
EAS_PROJECT_ID=
