# Replace this before starting. Do not use special URL characters in this password.
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
# Public Firebase web config. Leave blank to browse rooms without sign-in.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
# Firebase UIDs, not emails. Comma-separated. Empty means no admins.
ADMIN_UIDS=
